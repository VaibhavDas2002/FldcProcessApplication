# ====================================================================
# FLDC Process Application - Environment Configuration Template
# Copy this file to .env and provide your actual environment values
# ====================================================================

# ── Application Runtime ──────────────────────────────────────────────
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# ── Primary Database Connection ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=annapurna_consolidated
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=dbt_apy
DB_POOL_SIZE=10

# ── JWT Authentication (Resource Server) ─────────────────────────────
JWT_SECRET=replace_with_a_secure_random_base64_or_32_char_signing_key_here!
JWT_EXPIRATION_MS=86400000

# ── Cross-Origin Resource Sharing (CORS) ─────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Multi-Tenant / Zone Database Configuration ───────────────────────
ZONE_DB_ACTIVE_ZONES=2
ZONE_DB_DEFAULT=zone1

ZONE1_DISTRICT_CODES=306,304,664,305,307,308,309,310,311,312,313,314
ZONE2_DISTRICT_CODES=303,703,702,315,316,317,318,319,320,704,306,321

# Zone 1 Database
DB_ZONE1_HOST=localhost
DB_ZONE1_PORT=5432
DB_ZONE1_DATABASE=annapurna_z1
DB_ZONE1_USERNAME=postgres
DB_ZONE1_PASSWORD=your_zone1_password

# Zone 2 Database
DB_ZONE2_HOST=localhost
DB_ZONE2_PORT=5432
DB_ZONE2_DATABASE=annapurna_z2
DB_ZONE2_USERNAME=postgres
DB_ZONE2_PASSWORD=your_zone2_password

# Auth / Consolidated Database
DB_AUTH_READ_HOST=localhost
DB_AUTH_READ_PORT=5432
DB_AUTH_DATABASE=annapurna_consolidated
DB_AUTH_READ_USERNAME=postgres
DB_AUTH_READ_PASSWORD=your_auth_password

DB_AUTH_WRITE_HOST=localhost
DB_AUTH_WRITE_PORT=5432
DB_AUTH_WRITE_USERNAME=postgres
DB_AUTH_WRITE_PASSWORD=your_auth_password

